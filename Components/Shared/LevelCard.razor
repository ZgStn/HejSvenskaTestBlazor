
@using Microsoft.AspNetCore.Components

@*det är en child komponent.
 Syftet är att skapa återanvändbar komponent med 3 parametrar
Nivå 1
Grundläggande
Enkla ord och uttryck*@


<h2>@Title</h2>
<p>@Description</p>



@code {
    [Parameter]
