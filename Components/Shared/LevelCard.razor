
@using Microsoft.AspNetCore.Components

@*det är en child komponent.
 Syftet är att skapa återanvändbar komponent med 3 parametrar
Nivå 1
Grundläggande
Enkla ord och uttryck*@

<div class="level-card">
    
    <h2><a href="/levels/@Level">@Title</a></h2>

    <p>@Description</p>

</div>
@* <a href="/levels/@Level">Gå till Nivå @Level</a> *@



@code {
    [Parameter]
    public int Level { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

}