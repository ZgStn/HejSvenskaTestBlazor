@page "/topics/{id}"
@rendermode InteractiveServer
@inject ITopicService TopicService

@if (isLoading)
{
    <p>Laddar...</p>
}
else if (loadError != null)
{
    <p>@loadError</p>
}
else if (topic == null)
{
    <p>Ämnet hittades inte.</p>
}
else
{
    <h1>@topic.Title</h1>

    <a href="/">← Tillbaka till hem</a>
@* det går igenom alla ord i topic.Words och skapar en WordCard för varje ord *@
    <div class="topic-words">
        @foreach (var w in topic.Words)
        {
            <WordCard WordItem="@w" />
        }
       
    </div>
}

@code {
    [Parameter]
    public string id { get; set; } = "";

    private Topic? topic;
    private bool isLoading = true;
    private string? loadError;

    @*I TopicDetails.razor,
     där sidan måste veta vilket topic-id som kom från URL:en, passar OnParametersSetAsync() bättre.
     Så OnParametersSetAsync() används där eftersom datan beror på parametern Id.*@

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            topic = await TopicService.GetTopicByIdAsync(id);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}