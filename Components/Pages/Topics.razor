@page "/topics"
@inject ITopicService TopicService



@if (isLoading)
{
    <p>Loading topics...</p>
}
else if (loadError != null)
 {
    @loadError
 }
 else if (topics == null || !topics.Any())
 {
    <p>No topics available.</p>
 }
 else
 {
    @foreach (var topic in topics)
    {

           <div class="topic">
            <h2 class="topic-title">@topic.Title</h2>
            
            <div class="topic-words">

                @foreach (var w in topic.Words)
            {
                <article class="word-item">

                    <div class="word-top">
                          @if (!string.IsNullOrWhiteSpace(w.ImagePath))
                        {
                             <img src="@w.ImagePath" alt="@w.Text" />
                        }
                        <strong class="word-text">@w.Text</strong>
                    </div>
                    <p class="word-desc">@w.Description</p>

                     @if (!string.IsNullOrWhiteSpace(w.AudioPath))
                    {
                        <audio controls src="@w.AudioPath" class="word-audio"></audio>
                    }
                    </article>
                    }
            </div>
       </div>
     
    }
}


@code 
{
    private List<Topic>? topics;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            topics = await TopicService.GetTopicsAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load topics: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
