@page "/topics"
@inject ITopicService TopicService



@if (isLoading)
{
    <p>Loading topics...</p>
}
else if (loadError != null)
 {
    @loadError
 }
 else if (topics == null || !topics.Any())
 {
    <p>No topics available.</p>
 }
 else
 {
   @foreach (var topic in topics)
    {
        <div class="topic">

            <h2 class="topic-title">
                <a href="/topics/@topic.Id">
                    @topic.Title
                </a>
            </h2>

        </div>
            
    }
}


@code 
{
    private List<Topic>? topics;
    private bool isLoading = true;
    private string? loadError;

    @*I Topics.razor, där du bara hämtar alla topics och 
    inte är beroende av en route-parameter, passar OnInitializedAsync() bättre.
    OnInitializedAsync
    → komponenten startar
    *@
    protected override async Task OnInitializedAsync()
    {
        try
        {
            topics = await TopicService.GetTopicsAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load topics: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
