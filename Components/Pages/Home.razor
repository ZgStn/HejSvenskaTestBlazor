@page "/"
@using System.Diagnostics

<PageTitle>Home</PageTitle>

<h1>Hej Svenska!</h1>

<h3>En liten interaktiv app för att lära sig svenska ord. 
    <br />
    <br />
    Utforska olika ämnen och se ord med bild, ljud och beskrivning.</h3>

@foreach(var level in levels)
{
    <LevelCard
               Level="@level.Number"
               Title="@level.Title"
               Description="@level.Description" />
}


@code {

private List<Level> levels = new()
{
    new Level { Number = 1, Title = "Nivå 1", Description = "Grundläggande ord och fraser." },
    new Level { Number = 2, Title = "Nivå 2", Description = "Mellanliggande ord och fraser." },
};

}
